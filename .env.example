# Clerivon AI v1.1.0 — Lab / Pilot environment
# Copy to .env and adjust.

# --- App ---
APP_VERSION=1.1.0
SECRET_KEY=change_this_lab_secret
AUTO_SEED=true
LLM_PROVIDER=off

# --- Database (lab default: sqlite) ---
# sqlite | postgres
DB_BACKEND=sqlite
FRAUD_DB_PATH=fraud_cases.db

# Used when DB_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clerivon_fraud
DB_USER=clerivon_user
DB_PASSWORD=secure_password_change_in_prod

# Optional LLM keys (not required for synthetic tool path)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SSO stubs (not required for lab UI)
SSO_PROVIDER=none
