# Environment Variables Template for Production
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clerivon_fraud
DB_USER=clerivon_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# ===========================================
# LLM PROVIDER CONFIGURATION
# ===========================================
# Options: openai, anthropic, off (for deterministic mode)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===========================================
# SECURITY & SESSION
# ===========================================
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECURE_STRING

# ===========================================
# SSO / SAML CONFIGURATION
# ===========================================
# Options: azure_ad, okta, keycloak
SSO_PROVIDER=azure_ad

# Azure AD Configuration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Okta Configuration (if using Okta)
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_ISSUER_URL=https://your-okta-domain.okta.com/oauth2/default

# Keycloak Configuration (if using Keycloak)
KEYCLOAK_CLIENT_ID=your-keycloak-client-id
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret
KEYCLOAK_ISSUER_URL=https://your-keycloak-domain/auth/realms/your-realm

# SSO Logout URL
SSO_LOGOUT_URL=https://login.microsoftonline.com/logout.srf

# ===========================================
# DEPLOYMENT MODE
# ===========================================
# Set to 'air-gapped' for sovereign cloud deployments
DEPLOYMENT_MODE=standard

# ===========================================
# MONITORING
# ===========================================
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
